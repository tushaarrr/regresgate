# Secrets. This repo is public and the gate needs a real provider key, so this
# block is load-bearing: one `git add -A` without it publishes the key.
.env
.env.*
!.env.example
eval/.env.ci

# Working notes, kept local on purpose.
RESUME.md

# Local tooling
.venv/
__pycache__/
*.pyc

# Generated by store.py's demo run; rebuilt on every invocation.
regressgate/regressgate.db

# CI cache artifacts, not source. The verdict cache and the nightly run store
# are persisted by actions/cache between runs; committing them would freeze a
# verdict (or a 40-night series) into the repository.
regressgate/.verdicts/
regressgate/.store/
regressgate/baselines/
.drift-marker

# promptfoo eval exports
*.junit.xml
head.json
today.json
